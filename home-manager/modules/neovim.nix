{ pkgs, ... }:

# Neovim: LazyVim config lives in home-manager/dotfiles/nvim. lazy.nvim fetches
# the plugins at runtime, so everything declared here is a binary Neovim shells
# out to: LSP servers, formatters, linters, tree-sitter CLI, debug adapters.
# Mason is disabled in the Neovim config, since its runtime downloads do not run
# on NixOS.
let
  # CodeLLDB ships as a VSCode extension; Neovim needs the adapter script and
  # liblldb as plain paths.
  lldbRoot = "${pkgs.vscode-extensions.vadimcn.vscode-lldb}/share/vscode/extensions/vadimcn.vscode-lldb";

  # jdtls bundles for Java debugging, which Mason would otherwise install into
  # ~/.local/share/nvim: the java-debug and java-test Eclipse plugins.
  javaBundles = pkgs.runCommandLocal "jdtls-java-bundles" { } ''
    mkdir -p $out
    cp ${pkgs.vscode-extensions.vscjava.vscode-java-debug}/share/vscode/extensions/vscjava.vscode-java-debug/server/com.microsoft.java.debug.plugin-*.jar $out/
    cp ${pkgs.vscode-extensions.vscjava.vscode-java-test}/share/vscode/extensions/vscjava.vscode-java-test/server/com.microsoft.java.test.plugin-*.jar $out/
  '';
in
{
  home.packages = with pkgs; [
    neovim
    tree-sitter # nvim-treesitter compiles parsers on demand
    gnutar # nvim-treesitter unpacks parser sources

    # lua
    lua-language-server
    stylua

    # nix
    statix

    # typescript / javascript / json / css / html
    vtsls
    typescript
    vscode-langservers-extracted
    prettier

    # python
    pyright

    # rust
    rust-analyzer
    rustc
    clippy
    rustfmt
    cargo-nextest # neotest-rust

    # java
    google-java-format

    # clojure
    clojure-lsp
    clj-kondo

    # xml
    lemminx
    xmlformat
    libxml2 # xmllint

    # yaml / markdown
    yaml-language-server
    marksman
    markdownlint-cli2

    # sql
    sqls
    sqlfluff
    sqlite # dadbod connections

    # shell
    bash-language-server
    shfmt
    shellcheck

    # toml
    taplo

    # docker
    dockerfile-language-server
    docker-compose-language-service
    hadolint

    # ansible / helm
    ansible-language-server
    helm-ls

    # debug adapters
    vscode-js-debug # `js-debug`: node/js/ts DAP server

    # octo.nvim (GitHub PR review) shells out to gh
    gh
  ];

  # Paths the Lua config cannot know about; Neovim requires this module from
  # lua/plugins/dap.lua.
  xdg.configFile."nvim/lua/config/nix-paths.lua".text = ''
    -- Generated by home-manager (home-manager/modules/neovim.nix). Do not edit.
    return {
      codelldb = "${lldbRoot}/adapter/codelldb",
      codelldb_lib = "${lldbRoot}/lldb/lib/liblldb.so",
      java_debug_bundles = "${javaBundles}",
    }
  '';
}
